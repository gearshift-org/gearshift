{
  "name": "gearshift",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "electron:build": "bun run build && electron-builder",
    "dist": "rm -rf release/mac-arm64 release/mac release/builder-*.yaml release/builder-*.yml && CSC_IDENTITY_AUTO_DISCOVERY=false bun run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir --config.mac.identity=null --config.mac.notarize=false",
    "dist:dmg": "rm -rf release/mac-arm64 release/mac release/builder-*.yaml release/builder-*.yml && CSC_IDENTITY_AUTO_DISCOVERY=false bun run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --config.mac.identity=null --config.mac.notarize=false",
    "dist:dmg:signed": "rm -rf release/mac-arm64 release/mac release/builder-*.yaml release/builder-*.yml && bun run build && electron-builder --mac dmg",
    "install:app": "bun run dist && node scripts/install-macos-app.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.gearshift",
    "productName": "GearShift",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "gearshift-org",
      "repo": "gearshift"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    }
  },
  "dependencies": {
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@libsql/client": "^0.17.3",
    "@parcel/watcher": "^2.5.6",
    "@tanstack/query-sync-storage-persister": "^5.100.13",
    "@tanstack/react-query": "^5.100.13",
    "@tanstack/react-query-persist-client": "^5.100.13",
    "@xterm/addon-web-links": "^0.12.0",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.3",
    "material-icon-theme": "^5.35.0",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/inter": "^5.2.8",
    "@pierre/diffs": "^1.1.22",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "^1.170.7",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "lucide-react": "^1.16.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.11.1",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.14",
    "vite-plugin-electron": "^0.29.1"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "electron",
    "esbuild",
    "node-pty"
  ]
}
